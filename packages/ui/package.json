{
  "name": "@mendylanda/ui",
  "version": "0.1.0",
  "description": "Mendy Landa’s reusable React components. Typed filters with dynamic options, URL persistence, and customizable UI.",
  "homepage": "https://ui.mendylanda.com",
  "license": "MIT",
  "author": "Mendy Landa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MendyLanda/mendy-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "import": "./dist/filters/index.js",
      "default": "./dist/filters/index.js"
    },
    "./filters/core": {
      "types": "./dist/filters/core.d.ts",
      "import": "./dist/filters/core.js",
      "default": "./dist/filters/core.js"
    },
    "./filters/nuqs": {
      "types": "./dist/filters/nuqs.d.ts",
      "import": "./dist/filters/nuqs.js",
      "default": "./dist/filters/nuqs.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js",
      "default": "./dist/primitives/*.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.11.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "nuqs": "^2.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "nuqs": {
      "optional": true
    }
  }
}
